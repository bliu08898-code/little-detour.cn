# 必填：在高德开放平台创建“Web 服务”类型 Key
AMAP_WEB_SERVICE_KEY=

# 选填：阿里云百炼 API Key。留空时仍会从真实地点中按规则选择，并使用内置 Mission 文案
DASHSCOPE_API_KEY=
# 使用百炼控制台显示的业务空间专属 API Host，并保留 /compatible-mode/v1 路径
DASHSCOPE_BASE_URL=https://YOUR_WORKSPACE_ID.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-flash

# 浏览器 Geolocation 通常返回 GPS/WGS84 坐标；如果宿主已返回高德坐标，可改为 autonavi
AMAP_INPUT_COORDSYS=gps

# 服务端口
PORT=8787

# 本地可保持默认；公开托管平台需要监听所有网络接口
HOST=0.0.0.0
